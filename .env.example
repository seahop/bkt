# =============================================================================
# bkt — environment configuration example
# =============================================================================
# This file is for the MULTI-CONTAINER layouts (docker-compose.yml for dev,
# docker-compose.prod.yml for prod). Copy it to `.env` and fill it in — or just
# run `python3 setup.py`, which generates the secrets and TLS certs for you.
#
# The single-container OMNIBUS image (`ghcr.io/seahop/bkt`) needs NONE of this:
# it auto-generates secrets on first boot into its /data volume and takes plain
# `docker run -e VAR=value` overrides. See docs/deployment/configuration.md.
#
# Variable names here are cross-checked against docker-compose.yml and
# docker-compose.prod.yml. Never commit your real `.env` (it is gitignored).
# =============================================================================

# ── Image version (docker-compose.prod.yml only) ─────────────────────────────
# Tag of the ghcr.io/seahop/bkt-backend image to run. Defaults to "latest".
#   BKT_VERSION=1.0.0 docker compose -f docker-compose.prod.yml up -d
BKT_VERSION=latest

# ── Database ─────────────────────────────────────────────────────────────────
# DB_HOST/PORT/USER/NAME are fixed by the compose files (service name "postgres")
# and normally don't need changing. DB_PASSWORD is auto-generated by setup.py —
# DO NOT set it by hand.
DB_HOST=postgres
DB_PORT=5432
DB_USER=objectstore
DB_PASSWORD=<generated_by_setup.py>
DB_NAME=objectstore
# TLS mode for the backend -> Postgres connection. Postgres runs with SSL on, so
# "require" is expected in the compose stack. Others: disable, verify-ca, verify-full.
DB_SSL_MODE=require

# ── Backend secrets ──────────────────────────────────────────────────────────
# Both are auto-generated by setup.py (re-running it only fills in missing,
# <placeholder>, old-default or too-short values — it never rotates valid ones,
# and a replaced value is kept as a decrypt-only key below). They must stay
# STABLE for the life of the deployment. To create them by hand:
#   openssl rand -hex 32
# The backend refuses to start (in EVERY GO_ENV) if JWT_SECRET is empty,
# shorter than 32 characters, the old public dev default, or still a
# <placeholder>; the same rules apply to ENCRYPTION_KEY when it is set.
#
# JWT_SECRET      — signs JWT access/refresh tokens.
# ENCRYPTION_KEY  — encrypts external-S3 credentials stored in Postgres.
#                   ⚠️  CRITICAL: a database backup WITHOUT this key cannot be
#                   fully restored — stored S3 configs become undecryptable.
#                   Back it up securely alongside (ideally separately from) your
#                   data. See docs/deployment/backup-restore.md.
#                   Required in production. In development an empty value
#                   falls back to a JWT_SECRET-derived key (with a warning).
JWT_SECRET=<generated_by_setup.py>
ENCRYPTION_KEY=<generated_by_setup.py>

# Key rotation / migration — DECRYPT-ONLY keys (never used to encrypt; exempt
# from the strength rules). Leave empty unless you are rotating.
# ENCRYPTION_KEY_PREVIOUS      — comma-separated retired ENCRYPTION_KEY values.
#                                To rotate: move the current ENCRYPTION_KEY here
#                                and set a new ENCRYPTION_KEY.
# ENCRYPTION_LEGACY_JWT_SECRET — a retired JWT_SECRET that encrypted stored
#                                credentials while no ENCRYPTION_KEY was set
#                                (needed when you rotate such a JWT_SECRET).
# At startup the backend re-encrypts stored credentials under ENCRYPTION_KEY
# and logs when these are no longer needed; remove them then.
# ENCRYPTION_REENCRYPT_ON_STARTUP=false disables that pass (default true).
#ENCRYPTION_KEY_PREVIOUS=
#ENCRYPTION_LEGACY_JWT_SECRET=
#ENCRYPTION_REENCRYPT_ON_STARTUP=true

# ── Runtime mode & ports ─────────────────────────────────────────────────────
# GO_ENV=production additionally requires ENCRYPTION_KEY, a non-default
# DB_PASSWORD and TLS, and turns the Swagger UI off by default
# (docker-compose.prod.yml sets this). docker-compose.yml passes this value
# through (default "development"). APP_ENV is accepted as a legacy alias
# only when GO_ENV is unset (both compose files always set GO_ENV).
GO_ENV=production
# Gin framework mode. The backend defaults to "release" (quiet); docker-compose.yml
# sets "debug" (prints every route at startup). Values: release | debug | test.
#GIN_MODE=release
# TLS (docker-compose.yml only — docker-compose.prod.yml always serves TLS
# with the setup.py certs). Paths are inside the container.
#TLS_ENABLED=true
#TLS_CERT_FILE=/certs/backend.crt
#TLS_KEY_FILE=/certs/backend.key
#TLS_CA_FILE=/certs/ca.crt
# Set to true (with TLS_ENABLED=false) when a reverse proxy / ingress
# terminates TLS in front of bkt; satisfies the production TLS requirement
# (docker-compose.yml, the Helm chart and the omnibus image).
#TLS_TERMINATED_UPSTREAM=false
# Port note: the console (web UI + REST API) listens on 9443, and the
# S3-compatible API (aws-cli / s3fs) listens on 9000. SERVER_PORT below is the
# S3-compatible API port used by the compose stack. The listener settings
# CONSOLE_PORT / S3_API_PORT / SERVER_HOST are NOT passed through by the
# compose files (their port mappings and healthchecks assume 9443/9000);
# change the host side of `ports:` instead.
SERVER_PORT=9000

# ── Admin user ───────────────────────────────────────────────────────────────
# ADMIN_PASSWORD is auto-generated by setup.py — DO NOT set it by hand.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<generated_by_setup.py>
ADMIN_EMAIL=admin@example.com
ALLOW_REGISTRATION=false
# Max login attempts per minute per IP (dev compose default: 60).
AUTH_RATE_LIMIT=60
# Token refreshes per minute per IP — a separate, larger budget (default 30).
#AUTH_REFRESH_RATE_LIMIT=30
# Access / refresh token lifetimes (Go durations: 15m, 1h, 168h, ...).
#ACCESS_TOKEN_EXPIRY=15m
#REFRESH_TOKEN_EXPIRY=168h
# Comma-separated CIDRs/IPs of reverse proxies whose X-Forwarded-For may be
# trusted for rate limiting. Leave empty (default) when clients connect
# directly — then the socket address is used and the header is ignored.
# Behind a proxy, set this to the proxy's address or all clients share one
# rate-limit bucket (the proxy's IP).
#TRUSTED_PROXIES=
# Optional per-IP request limit per minute on the S3 API listener. Unset or 0
# disables S3 rate limiting (the console/auth limiter is separate).
#S3_RATE_LIMIT=0
# Days to keep audit log rows; older rows are pruned every 15 minutes.
# <= 0 disables pruning. Default: 90.
#AUDIT_RETENTION_DAYS=90
# When set, GET /metrics requires "Authorization: Bearer <token>". Leave unset
# only if the metrics endpoint is network-isolated (it exposes bucket/object/
# user counts); production logs a warning when it is unset.
#METRICS_TOKEN=
# Serve the Swagger UI at /api/docs/ (default: on in development, off in
# production).
#SWAGGER_ENABLED=
# Strict-Transport-Security max-age in seconds for the console when TLS is on
# (never sent for localhost / IP hosts). 0 disables.
#HSTS_MAX_AGE=31536000
# Base URL clients use to reach the S3 listener; embedded in presigned URLs
# generated by the console (e.g. https://bkt.example.com:9000). When unset,
# derived from the console request's hostname + the S3 API port.
#S3_PUBLIC_ENDPOINT=
# Bucket-notification webhooks may not reach private, loopback, link-local
# (incl. cloud metadata) or reserved addresses. Comma-separated hostnames, IPs
# or CIDRs listed here are exempt (e.g. an internal receiver).
#WEBHOOK_ALLOWED_HOSTS=hooks.internal.example.com,10.20.0.0/16
# Explicit http(s) egress proxy for webhook deliveries (Basic auth via
# user:pass@ is allowed). Targets are still SSRF-checked before each attempt,
# but the proxy resolves them again — deny private ranges on the proxy too.
# Unset = connect directly; HTTP_PROXY/HTTPS_PROXY are never used.
#WEBHOOK_PROXY_URL=http://egress-proxy.internal:3128

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of browser origins allowed to call the API. Set this to
# your real frontend domain(s) in production. If left empty, the backend falls
# back to its built-in localhost dev origins.
CORS_ALLOWED_ORIGINS=https://localhost
# Whether the API allows credentialed (cookie/authorization) cross-origin requests.
CORS_ALLOW_CREDENTIALS=true

# ── Storage backend ──────────────────────────────────────────────────────────
# Options: "local" (default) or "s3".
STORAGE_BACKEND=local
STORAGE_ROOT=/data/buckets
# Ignore the client's Content-Type, detect it from magic bytes and reject
# unsafe types (default false — S3's contract is client-declared metadata).
#CONTENT_TYPE_ENFORCEMENT=false

# ── S3 storage backend (only needed if STORAGE_BACKEND=s3) ───────────────────
# Uncomment and configure to use an S3-compatible service as the object store.
# NOTE: Never paste AWS credentials into chat or commit them to git.
#       Add them to your local .env file (which is gitignored) only.
#S3_ENABLED=true
#S3_ENDPOINT=s3.amazonaws.com       # leave as-is for AWS; set to MinIO URL etc for others
#S3_REGION=us-east-1
#S3_ACCESS_KEY_ID=                  # your AWS access key ID
#S3_SECRET_ACCESS_KEY=              # your AWS secret access key
#S3_BUCKET_PREFIX=                  # optional: prefix all bkt bucket names in S3 (e.g. "bkt-")
#S3_USE_SSL=true
#S3_FORCE_PATH_STYLE=false          # set true for MinIO or other non-AWS S3
# Request SSE-S3 (AES256) server-side encryption on every object written
# through the external S3 backend. Local-backend bytes are NOT encrypted by
# bkt — use disk-level encryption (LUKS/dm-crypt) for at-rest protection.
#S3_SSE=false
#S3_BUCKETS=                        # optional: comma-separated S3 buckets to auto-provision
                                    # on startup (linked if they exist, created otherwise).
                                    # Each appears in the UI, owned by the admin user.

# ── OIDC — browser-based SSO with any OpenID Connect provider (optional) ─────
# Keycloak, Okta, Entra ID (Azure AD), Auth0, Authentik, Kanidm, Vault, ...
# Authorization-code flow with PKCE (S256) is always used. Endpoints are read
# from <OIDC_ISSUER_URL>/.well-known/openid-configuration. Enabled automatically
# when the issuer and client ID are set (OIDC_ENABLED=false to keep it off).
#OIDC_ENABLED=
#OIDC_ISSUER_URL=https://idp.example.com/realms/myrealm
#OIDC_CLIENT_ID=bkt
#OIDC_CLIENT_SECRET=                # optional: set for a confidential client; leave empty for a public (PKCE-only) client
#OIDC_REDIRECT_URL=https://localhost:9443/api/auth/oidc/callback   # must match the IdP's registered redirect URI
#OIDC_SCOPES=openid profile email
#OIDC_PROVIDER_NAME=SSO             # login button label, e.g. "Okta"
# Claims mapping (all optional):
#OIDC_USERNAME_CLAIM=               # claim for the username at first login (default: preferred_username, then email local part). Entra ID: upn
#OIDC_GROUPS_CLAIM=groups           # claim carrying group names
#OIDC_ADMIN_GROUP=                  # members become bkt admins (re-checked every login); empty = admin is never granted via SSO
#OIDC_USER_GROUP=                   # if set, non-admins must be in this group or login is denied
#OIDC_POLICIES_CLAIM=policies       # claim listing bkt policy names to sync on each login
#OIDC_POLICIES_AUTHORITATIVE=       # default: true when OIDC_POLICIES_CLAIM is set — a missing claim then also clears the user's policies
#OIDC_LINK_BY_EMAIL=false           # link a new subject to an existing OIDC account with the same verified email (IdP migrations)
#OIDC_EXPECTED_ISSUER=              # issuer the IdP advertises when it differs from OIDC_ISSUER_URL (e.g. IdP reached via an internal hostname); empty = must equal OIDC_ISSUER_URL

# ── Google OIDC — browser-based SSO (optional) ───────────────────────────────
#GOOGLE_OIDC_ENABLED=true
#GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
#GOOGLE_CLIENT_SECRET=your-google-client-secret
#GOOGLE_REDIRECT_URL=https://localhost:9443/api/auth/google/callback
# Comma-separated Workspace domains allowed to sign in (hd claim AND email
# domain must match). Unset: new Google users are only auto-provisioned when
# ALLOW_REGISTRATION=true.
#GOOGLE_ALLOWED_DOMAINS=example.com
# Google Workspace group -> bkt policy sync (service account with domain-wide
# delegation; the key file path is inside the container — mount it yourself).
#GOOGLE_WORKSPACE_ENABLED=false
#GOOGLE_SERVICE_ACCOUNT_KEY_FILE=/etc/bkt/google-service-account.json
#GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@example.com
#GOOGLE_POLICY_SYNC_MODE=direct     # "direct" (group name = policy name) or "prefix"
#GOOGLE_POLICY_GROUP_PREFIX=        # prefix mode: only groups like "bkt-engineering" map (prefix "bkt-")

# ── Vault OIDC — browser-based SSO with PKCE (optional, recommended) ──────────
# Public client — no client secret needed, uses PKCE for security.
#VAULT_OIDC_ENABLED=true
#VAULT_ADDR=https://vault.example.com
#VAULT_OIDC_CLIENT_ID=your-vault-oidc-client-id
#VAULT_OIDC_PROVIDER_URL=https://vault.example.com/v1/identity/oidc/provider/default
#VAULT_OIDC_REDIRECT_URL=https://localhost:9443/api/auth/vault/callback
#VAULT_OIDC_SCOPES=openid profile
#VAULT_OIDC_EXPECTED_ISSUER=        # issuer Vault advertises when it differs from VAULT_OIDC_PROVIDER_URL (Vault api_addr != the URL bkt uses); empty = must match
#VAULT_POLICIES_AUTHORITATIVE=false # true: a Vault "policies" claim always replaces the user's bkt policies (empty/unmatched claim removes all); false: only when a claimed name matches an existing bkt policy
# Legacy Vault JWT login (token pasted into the login modal):
#VAULT_SSO_ENABLED=false
#VAULT_JWT_AUDIENCE=object-storage  # required "aud"
#VAULT_JWT_ISSUER=                  # if set, required "iss"
#VAULT_JWT_PATH=auth/jwt            # JWT auth mount; JWKS = <VAULT_ADDR>/v1/<path>/.well-known/jwks.json
#VAULT_JWT_ROLE=object-storage-users

# Base URL that SSO flows redirect back to after authentication — the console
# origin users browse to. Default: the console listener (https://localhost:9443);
# the dev compose stack defaults to the vite dev server (https://localhost:5173).
# The SSO callback only accepts tokens for a login started from that same origin.
#FRONTEND_URL=https://localhost:9443

# ── Deprecated ───────────────────────────────────────────────────────────────
# VITE_API_URL is NO LONGER USED. The web UI is compiled into the backend image
# and served from the console port (9443); there is no separate frontend
# container in the prod/omnibus layouts. (The dev compose stack sets its own
# VITE_API_URL on the frontend service directly.) Left here only as a note —
# safe to delete.
#VITE_API_URL=
