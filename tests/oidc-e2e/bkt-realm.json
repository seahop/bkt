{
  "realm": "bkt",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "groups": [
    {
      "name": "bkt-admins",
      "path": "/bkt-admins"
    },
    {
      "name": "bkt-users",
      "path": "/bkt-users"
    },
    {
      "name": "unrelated",
      "path": "/unrelated"
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "alice-pass-1",
          "temporary": false
        }
      ],
      "groups": [
        "/bkt-admins",
        "/bkt-users"
      ]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "bob-pass-1",
          "temporary": false
        }
      ],
      "groups": [
        "/bkt-users"
      ]
    },
    {
      "username": "carol",
      "email": "carol@example.com",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Outsider",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "carol-pass-1",
          "temporary": false
        }
      ],
      "groups": [
        "/unrelated"
      ]
    }
  ],
  "clients": [
    {
      "clientId": "bkt",
      "name": "bkt console",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "bkt-client-secret-for-tests",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "redirectUris": [
        "https://oidc-e2e-bkt:9443/api/auth/oidc/callback"
      ],
      "webOrigins": [
        "https://oidc-e2e-bkt:9443"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ]
}